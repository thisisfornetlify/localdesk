# Copy this file to .env. Fill only the services you want, then restart the app.
# Never share .env or commit it to Git. Simple KEY=value syntax; no shell interpolation.

# Optional data location (default: data/ alongside app.py)
# LOCALDESK_DATA=C:/Users/you/Documents/LocalDeskData

# IMAP email sorter. Use a provider-specific app password where required.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# SMTP digests and change alerts. Port 587 uses STARTTLS; 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Telegram: create a bot with BotFather; start a conversation with it first.
# Only this exact chat ID can issue commands to the polling bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: incoming channel webhook (messages and polls).
DISCORD_WEBHOOK_URL=

# Ollama service on this machine. Install/pull these models separately.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=embeddinggemma

# OCR: leave unset to use tesseract on PATH.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Smart devices via MQTT. TLS requires broker certificates trusted by this machine.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TLS=false

# Add your HTTP device token variables, then reference their names in Home hub.
# HOME_ASSISTANT_TOKEN=
